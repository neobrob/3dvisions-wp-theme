{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        { "slug": "teal", "name": "Teal 3DV", "color": "#146074" },
        { "slug": "teal-900", "name": "Teal 900 (foncé)", "color": "#0B3743" },
        { "slug": "teal-500", "name": "Teal 500", "color": "#2C7E93" },
        { "slug": "teal-300", "name": "Teal 300", "color": "#9EC8D2" },
        { "slug": "teal-100", "name": "Teal 100 (clair)", "color": "#E4F0F2" },
        { "slug": "indigo-teal", "name": "Indigo-teal (piste B — fond sombre viewer)", "color": "#12303F" },
        { "slug": "quasi-noir", "name": "Quasi-noir (piste B — viewer)", "color": "#14181A" },
        { "slug": "cyan-technique", "name": "Cyan technique (piste B — accent UI uniquement, jamais en texte)", "color": "#2FD9E8" },
        { "slug": "stone", "name": "Stone (neutre)", "color": "#F2EEE7" },
        { "slug": "ink", "name": "Encre (texte)", "color": "#1D1D2B" },
        { "slug": "white", "name": "Blanc", "color": "#FFFFFF" }
      ],
      "custom": true,
      "customGradient": true,
      "defaultPalette": false
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "'Inter', system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Inter", "fontWeight": "400 700", "fontStyle": "normal", "src": ["file:./assets/fonts/inter-variable.woff2"] }
          ]
        },
        {
          "slug": "bai-jamjuree",
          "name": "Bai Jamjuree",
          "fontFamily": "'Bai Jamjuree', sans-serif",
          "fontFace": [
            { "fontFamily": "Bai Jamjuree", "fontWeight": "600", "fontStyle": "normal", "src": ["file:./assets/fonts/bai-jamjuree-600.woff2"] },
            { "fontFamily": "Bai Jamjuree", "fontWeight": "700", "fontStyle": "normal", "src": ["file:./assets/fonts/bai-jamjuree-700.woff2"] },
            { "fontFamily": "Bai Jamjuree", "fontWeight": "800", "fontStyle": "normal", "src": ["file:./assets/fonts/bai-jamjuree-800.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Petit", "size": "0.875rem" },
        { "slug": "medium", "name": "Texte courant", "size": "1rem" },
        { "slug": "large", "name": "Intro / lead", "size": "1.25rem" },
        { "slug": "x-large", "name": "H2", "size": "2rem" },
        { "slug": "xx-large", "name": "H1", "size": "2.75rem" }
      ],
      "customFontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "spacingScale": {
        "steps": 7
      },
      "units": ["px", "%", "em", "rem", "vh", "vw"]
    },
    "border": { "radius": true, "width": true, "color": true },
    "custom": {
      "note-nuancier": "Piste B — Précision Numérique appliquée le 10.09.2026 (choix provisoire, à confirmer). Le teal marketing (teal, teal-900, etc.) ne change pas — B ajoute seulement indigo-teal / quasi-noir / cyan-technique pour les futurs modules techniques (visionneuse 3D, points de scan, loupe de zoom). Le cyan ne doit jamais servir de couleur de texte courant (contraste 1.7:1 sur blanc, insuffisant) : décoratif/UI uniquement, sur fond sombre. Voir design-system-web-v1.md pour les 2 autres pistes écartées pour l'instant (A — terre cuite, C — prune)."
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--bai-jamjuree)",
          "fontWeight": "700"
        },
        "color": { "text": "var(--wp--preset--color--teal-900)" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--teal)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--teal-900)" } }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--teal)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": { "radius": "4px" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "En-tête", "area": "header" },
    { "name": "footer", "title": "Pied de page", "area": "footer" }
  ]
}
